# Copia a /var/www/guiders-backend/.env.production  (chmod 600)
# Sustituye __DOMAIN__ y todos los <genera>. No commitees valores reales.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ENABLE_SWAGGER=false
TYPEORM_SYNC=false

APP_URL=https://api.__DOMAIN__
JWKS_BASE_URL=https://api.__DOMAIN__

# Postgres (contenedor docker-compose)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=guiders
DATABASE_PASSWORD=<genera>
DATABASE=guiders

# Mongo
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=guiders
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=<genera>
MONGODB_USERNAME=guiders
MONGODB_PASSWORD=<genera>

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Keycloak (compose + Nest OIDC)
KEYCLOAK_HOSTNAME=auth.__DOMAIN__
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<genera>
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=<genera>
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PORT=5434
KEYCLOAK_ISSUER=https://auth.__DOMAIN__/realms/guiders
KEYCLOAK_JWKS_URI=https://auth.__DOMAIN__/realms/guiders/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account

OIDC_ISSUER=https://auth.__DOMAIN__/realms/guiders
OIDC_CONSOLE_CLIENT_ID=console
OIDC_CONSOLE_REDIRECT_URI=https://api.__DOMAIN__/api/bff/auth/callback/console
OIDC_ADMIN_CLIENT_ID=admin
OIDC_ADMIN_REDIRECT_URI=https://api.__DOMAIN__/api/bff/auth/callback/admin

SAMESITE=lax
COOKIE_SECURE=true
COOKIE_PATH=/
REFRESH_PATH=/api/bff/auth/refresh
SESSION_COOKIE_CONSOLE=console_session
REFRESH_COOKIE_CONSOLE=console_refresh
SESSION_COOKIE_ADMIN=admin_session
REFRESH_COOKIE_ADMIN=admin_refresh
ALLOW_RETURN_TO=https://console.__DOMAIN__,https://admin.__DOMAIN__

SESSION_STORE=redis
ENCRYPTION_KEY=<openssl rand -base64 32>
GLOBAL_TOKEN_SECRET=<openssl rand -base64 64>
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

CONSENT_VERSION_CURRENT=v1.4.0
ENABLE_SEMVER_COMPATIBILITY=true

# AWS S3 (avatares)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=
AWS_S3_AVATAR_FOLDER=avatars

# LLM
GROQ_API_KEY=
